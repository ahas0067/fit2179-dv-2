{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "transparent",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/basketball_demographics.csv"
  },
  "transform": [
    {
      "filter": "datum.chart_group == 'age_group'"
    },
    {
      "calculate": "format(datum.participation_rate_pct, '.1f') + '%'",
      "as": "participation_rate_label"
    }
  ],
  "title": {
    "text": "Basketball participation peaks in the teenage years",
    "subtitle": "Participation rate by age group, 2025",
    "anchor": "start",
    "font": "Inter",
    "subtitleFont": "Inter",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "color": "#F5F7FA",
    "subtitleColor": "#AAB4C0"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "opacity": 0.75
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "65+",
            "55-64",
            "45-54",
            "35-44",
            "25-34",
            "18-24",
            "15-17",
            "12-14",
            "9-11",
            "5-8",
            "0-4"
          ],
          "axis": {
            "title": "Age",
            "titleColor": "#AAB4C0",
            "titleFont": "Inter",
            "titleFontSize": 13,
            "labelColor": "#D8DEE9",
            "labelFont": "Inter",
            "labelFontSize": 12,
            "domain": false,
            "ticks": false
          }
        },
        "x": {
          "datum": 0,
          "type": "quantitative"
        },
        "x2": {
          "field": "participation_rate_pct",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.age_group == '15-17'",
            "value": "#28B7FF"
          },
          "value": "#5F6B7A"
        },
        "tooltip": [
          {
            "field": "age_group",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "participation_rate_pct",
            "type": "quantitative",
            "title": "Participation rate (%)",
            "format": ".1f"
          },
          {
            "field": "participants_est",
            "type": "quantitative",
            "title": "Estimated participants",
            "format": ","
          },
          {
            "field": "base_population_est",
            "type": "quantitative",
            "title": "Estimated population base",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "stroke": "#0B111B",
        "strokeWidth": 1.4
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "65+",
            "55-64",
            "45-54",
            "35-44",
            "25-34",
            "18-24",
            "15-17",
            "12-14",
            "9-11",
            "5-8",
            "0-4"
          ]
        },
        "x": {
          "field": "participation_rate_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              18
            ]
          },
          "axis": {
            "title": "Participation Rate (%)",
            "titleColor": "#AAB4C0",
            "labelColor": "#AAB4C0",
            "titleFont": "Inter",
            "labelFont": "Inter",
            "gridColor": "#2E3746",
            "values": [
              0,
              3,
              6,
              9,
              12,
              15,
              18
            ],
            "format": ".0f"
          }
        },
        "color": {
          "condition": {
            "test": "datum.age_group == '15-17'",
            "value": "#28B7FF"
          },
          "value": "#8A96A6"
        },
        "tooltip": [
          {
            "field": "age_group",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "participation_rate_pct",
            "type": "quantitative",
            "title": "Participation rate (%)",
            "format": ".1f"
          },
          {
            "field": "participants_est",
            "type": "quantitative",
            "title": "Estimated participants",
            "format": ","
          },
          {
            "field": "base_population_est",
            "type": "quantitative",
            "title": "Estimated population base",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#F5F7FA"
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "65+",
            "55-64",
            "45-54",
            "35-44",
            "25-34",
            "18-24",
            "15-17",
            "12-14",
            "9-11",
            "5-8",
            "0-4"
          ]
        },
        "x": {
          "field": "participation_rate_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "participation_rate_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_group == '15-17'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 58,
        "dy": -18,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#28B7FF"
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "65+",
            "55-64",
            "45-54",
            "35-44",
            "25-34",
            "18-24",
            "15-17",
            "12-14",
            "9-11",
            "5-8",
            "0-4"
          ]
        },
        "x": {
          "field": "participation_rate_pct",
          "type": "quantitative"
        },
        "text": {
          "value": "Peak"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false
    }
  }
}